# arm64 workload image overrides — OPT-IN template, never auto-loaded.
#
# The published koku / koku-service-operator images are amd64-only (multi-arch
# is pending: project-koku/koku-service-operator#219). Until then, arm64
# clusters need arm64 rebuilds of the four workload images below. To use them,
# copy this file over (or merge it into) your local settings:
#
#   cp scripts/demo-preprod.arm64.env scripts/demo-preprod.local.env
#
# NOTE: the defaults below point at PERSONAL, unofficial rebuilds under
# quay.io/martin_povolny — a stopgap, not a supported source. The durable
# answer is multi-arch images published under quay.io/project-koku (also
# #219); rebuild your own and override the references if that matters to you.
# On arm64 the operator image itself must be built from source
# (--source=local; the published operator is amd64-only, so the registry
# source fails the architecture preflight by design).
#
# Nothing loads this file automatically — no flag, no profile. The
# single-node profile (--profile=single-node / --crc) is sizing only.
#
# How the arm64 rebuilds are produced (all with `docker buildx build
# --platform linux/arm64` on an arm64 host, then `--push`; the quay repos must
# be public):
#   koku                -> project-koku/koku (arch-neutral UBI Dockerfile)
#   insights-rbac       -> RedHatInsights/insights-rbac (arch-neutral UBI)
#   insights-ingress-go -> insights-onprem/insights-ingress-go
#   koku-ui-onprem      -> cross-arch: FROM --platform=linux/amd64 the published
#                          amd64 image AS bundle; COPY its static /opt/app-root/src
#                          onto registry.access.redhat.com/ubi9/nginx-126 (arm64).
#                          NB: only `docker buildx` honours the per-stage platform
#                          here; an OpenShift in-cluster build yields an amd64 image.
DEMO_KOKU_IMAGE=quay.io/martin_povolny/koku
DEMO_KOKU_TAG=768be82-arm64
DEMO_RBAC_IMAGE=quay.io/martin_povolny/insights-rbac
DEMO_RBAC_TAG=crc-arm64
DEMO_INGRESS_IMAGE=quay.io/martin_povolny/insights-ingress-go
DEMO_INGRESS_TAG=crc-arm64
DEMO_UI_IMAGE=quay.io/martin_povolny/koku-ui-onprem
DEMO_UI_TAG=crc-arm64

# RHBK / Keycloak operator: the channel deploy-rhbk.sh pins (stable-v22) is
# amd64-only; stable-v26 is the first arm64-capable channel. On arm64 clusters
# demo-preprod.sh pre-creates the Subscription on this channel automatically,
# so this line is only needed to override the channel further.
DEMO_RHBK_CHANNEL=stable-v26
