# Settings reference for scripts/demo-preprod.sh. Copy to
# scripts/demo-preprod.local.env and edit; already-exported environment
# variables win over both files. Every command-line flag has an
# environment-variable equivalent of the same name (--source → SOURCE).
#
#   cp scripts/demo-preprod.env.example scripts/demo-preprod.local.env
#
# `--help-env` renders this list automatically. Two entry formats are
# recognized: a shipped default (an uncommented assignment), or an optional
# override (a commented assignment with a trailing "# description").

# Cluster / namespaces --------------------------------------------------------
# KUBE_CONTEXT=clusterbot   # pin a kube context; default: the current one
NAMESPACE=cost-byoi
CR_NAME=cost-management
INFRA_NAMESPACE=cost-byoi-infra
KAFKA_NAMESPACE=kafka
KEYCLOAK_NAMESPACE=keycloak
KAFKA_CLUSTER_NAME=cost-onprem-kafka
# KUBECTL=oc              # kubectl-compatible binary (oc or kubectl)
# RHBK_SCRIPT=/path/to/deploy-rhbk.sh   # another Keycloak provisioner

# Operator install (registry and manual sources) ------------------------------
# SOURCE=registry         # registry | local | manual (same as --source)
# VERSION=v0.0.1          # catalog tag; default: latest stable (discovered from quay tags)
# CATALOG_REPO=quay.io/project-koku   # quay namespace for the catalog image
# CHANNEL=beta            # OLM subscription channel
# CATALOG_IMG=...         # full catalog image override; skips version discovery
# ARCH_CHECK=1            # 0 skips the image-architecture preflight (not recommended)
# RHBK_INSECURE_TLS=1     # deploy-rhbk.sh: skip TLS verification of the Keycloak Route
#                          # (labs with replaced ingress certs or TLS-inspecting proxies)
# PREREQS_ONLY=1          # stop after the prerequisites
# SKIP_PREREQS=1          # skip prerequisites; operator installs on existing infrastructure
# USER_CR_FILE=...        # apply this CostManagementServiceConfig instead of the rendered one (--cr-file)

# Local builds (SOURCE=local) --------------------------------------------------
# BUILD_MODE=auto         # auto | docker | openshift (in-cluster binary build)
# IMAGE_TAG=preprod       # tag for the built operator image
# IMG=...                 # full image reference override
# CONTAINER_TOOL=docker   # force docker|podman for BUILD_MODE=docker; auto-detect by default.

# Tenant bootstrap -------------------------------------------------------------
# The installer provisions a demo tenant (Customer + org schema) after the CMSC
# is Ready; without it, Settings > Display is broken and report data stays
# empty until the first source is added. These must match the Keycloak org_id
# and account_number claims — i.e. the first orgAdmin user in the RHBK values
# file (jwtAuth.realmUsers). Defaults match deploy-rhbk.sh's default realm.
# DEMO_ORG_ID=1234567        # Keycloak org_id claim of the demo admin user
# DEMO_ACCOUNT_NUMBER=7890123  # account_number claim of the demo admin user
# REALM_NAME=kubernetes      # Keycloak realm (must match deploy-rhbk.sh);
#                            # --reset deletes this realm
#                          # NB: BUILD_MODE=auto prefers the in-cluster OpenShift build whenever
#                          # IMG is the internal registry — set BUILD_MODE=docker to use this.
#                          # (podman pushes to the internal registry need `oc registry login`)

# Demo profile -----------------------------------------------------------------
# REALM_ADMIN_PASSWORD=...  # realm-user password for a fresh Keycloak; default: random (demo hardening)
# DEMO_SMOKE=1             # keep IQE_TEST_RUN/CURRENCY_URL in the rendered CR (CI/IQE)
# SINGLE_NODE=1            # small-cluster Kafka sizing (same as --single-node)

# Kafka sizing (also set by SINGLE_NODE=1) --------------------------------------
# KAFKA_BROKER_REPLICAS=1        # broker replicas (profile sets 1)
# KAFKA_CONTROLLER_REPLICAS=1    # controller replicas (profile sets 1)
# KAFKA_BROKER_STORAGE=10Gi      # broker PVC size (profile sets 10Gi)
# KAFKA_CONTROLLER_STORAGE=5Gi   # controller PVC size (profile sets 5Gi)
# STORAGE_CLASS=           # default: the cluster's default storage class

# Console / UI ------------------------------------------------------------------
OPEN_BROWSER=1
# CONSOLE_USERNAME=kubeadmin  # --console output
# CONSOLE_PASSWORD=...        # --console output (omit to print a hint instead)
TMUX_SESSION=koku-demo-preprod
WATCHER=klock
LOG_LEVEL=INFO

# Workload image overrides (arm64 clusters; see scripts/demo-preprod.arm64.env) --
# DEMO_KOKU_IMAGE= / DEMO_KOKU_TAG=, DEMO_RBAC_IMAGE= / DEMO_RBAC_TAG=,
# DEMO_INGRESS_IMAGE= / DEMO_INGRESS_TAG=, DEMO_UI_IMAGE= / DEMO_UI_TAG=
# (envoy and oauth2-proxy are Red Hat multi-arch; they never need overriding)
# DEMO_RHBK_CHANNEL=stable-v26  # arm64-capable RHBK operator channel

# Small single-node clusters (CRC, SNO labs): run with --single-node
# (alias --crc) for 1+1 Kafka sizing. Architecture is autodiscovered; arm64
# workload image overrides are the opt-in scripts/demo-preprod.arm64.env
# template — copy it to scripts/demo-preprod.local.env. See
# docs/development/crc-testing.md.
