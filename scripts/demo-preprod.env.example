# Copy to scripts/demo-preprod.local.env and edit.
# Already-exported environment variables win over this file.
#
#   cp scripts/demo-preprod.env.example scripts/demo-preprod.local.env

# Pin a context when juggling several clusters; default is the current context.
# KUBE_CONTEXT=clusterbot

# Operator install (registry and manual sources):
# VERSION=v0.0.1          # catalog tag; default: latest stable (discovered from quay tags)
# CATALOG_REPO=quay.io/project-koku   # quay namespace for the catalog image
# CHANNEL=beta            # OLM subscription channel
# CATALOG_IMG=...         # full catalog image override; skips version discovery
# ARCH_CHECK=1            # 0 skips the image-architecture preflight (not recommended)
# CONTAINER_TOOL=docker   # force docker|podman for local builds; default: auto-detect
#                          # (podman pushes to the internal registry need `oc registry login`)
NAMESPACE=cost-byoi
CR_NAME=cost-management
INFRA_NAMESPACE=cost-byoi-infra
KAFKA_NAMESPACE=kafka
KEYCLOAK_NAMESPACE=keycloak
KAFKA_CLUSTER_NAME=cost-onprem-kafka

# Optional: use another Keycloak provisioner instead of this repo's script.
# RHBK_SCRIPT=/path/to/deploy-rhbk.sh

OPEN_BROWSER=1
BUILD_MODE=auto
IMAGE_TAG=preprod
TMUX_SESSION=koku-demo-preprod
WATCHER=klock
LOG_LEVEL=INFO

# Local CRC (arm64, single node): run `./scripts/demo-preprod.sh --crc`. That layers
# scripts/demo-preprod.crc.env (KUBE_CONTEXT=crc, arm64 workload image overrides,
# 1+1 Kafka) under these settings. See docs/development/crc-testing.md.
